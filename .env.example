HOST=localhost
ENV=debug

DATABASE_HOST=localhost
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PSSW=postgres

BACKEND_PORT=8081
BACKEND_AUTHENTICATION_SECRET=

# Additional self-hosted git authorities, comma-separated "host[:port]=type" entries.
# type is one of: github | gitlab | gitea  (gitea covers Gitea, Forgejo and Codeberg).
# Well-known SaaS hosts are recognised automatically:
#   github.com (github), gitlab.com (gitlab), codeberg.org (gitea), gitea.com (gitea).
# The source URL supplies the scheme, so local HTTP instances are supported.
# Example:
# BACKEND_GIT_HOSTS=gitlab.corp.com=gitlab,gitea.corp.com:3000=gitea
BACKEND_GIT_HOSTS=

# Optional PATs keyed by authority, including github.com. Commas delimit entries and therefore
# cannot occur inside a PAT. Authentication headers are never written to logs.
# BACKEND_GIT_HOSTS_PAT=github.com=github_pat_xxx,gitlab.corp.com=glpat-xxx,gitea.corp.com:3000=gtpat-xxx
BACKEND_GIT_HOSTS_PAT=

# Deprecated fallback for existing deployments. Prefer BACKEND_GIT_HOSTS_PAT above.
# BACKEND_GITHUB_PAT_TOKEN=

# Isolated patcher dependencies are prepared by `./gradlew preparePatcherRuntimes`.
# The default is correct for local Gradle runs; the Docker image sets /app/patcher-runtimes.
BACKEND_PATCHER_RUNTIME_DIR=build/patcher-runtimes
BACKEND_PATCHER_WORKER_MAX_PROCESSES=4
BACKEND_PATCHER_WORKER_MAX_PER_RUNTIME=2
BACKEND_PATCHER_WORKER_IDLE_SECONDS=300
BACKEND_PATCHER_REFRESH_CONCURRENCY=4

HASURA_PORT=8082
HASURA_GRAPHQL_ADMIN_SECRET=
